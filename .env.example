# Copy to .env for local development; never commit real secrets.
LEAD_QUALIFIER_DB=instance/lead_qualifier.sqlite3
LEAD_QUALIFIER_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
LEAD_QUALIFIER_TENANT_ID=tenant_default
LEAD_QUALIFIER_RATE_LIMIT_PER_MINUTE=60

# Optional multi-tenant token map. When set, this map takes precedence over the single-token variables.
# Include only the scopes each token needs: intake, status, booking.
# LEAD_QUALIFIER_API_TOKENS=[{"token":"CHANGE_ME","tenant_id":"tenant_default","scopes":["intake","status"]},{"token":"CHANGE_ME","tenant_id":"tenant_default","scopes":["booking"]}]

# Separate token map for human-review actions. Bind reviewer identity/RBAC in the host app before customer-facing use.
# LEAD_QUALIFIER_REVIEW_TOKENS=[{"token":"CHANGE_ME","tenant_id":"tenant_default","scopes":["review"]}]

# Generic signed channel webhooks. Each secret is channel-specific and tenant-scoped.
# LEAD_QUALIFIER_WEBHOOK_SECRETS=[{"channel":"website_form","secret":"CHANGE_ME","tenant_id":"tenant_default"}]

# Optional OpenAI evidence extraction; only used when extract_lead_facts() is called.
# OPENAI_API_KEY=
LEAD_QUALIFIER_EXTRACTION_MODEL=gpt-4o-mini

# Optional Telegram admin alert queue.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# Optional Cal.com availability and booking. Booking requires a separately scoped API token,
# stored lead consent, explicit booking consent, and an approved review decision.
# CAL_COM_API_KEY=
# CAL_COM_EVENT_TYPE_ID=
CAL_COM_API_VERSION=2026-02-25

# Production WSGI server reads PORT from the hosting platform.
